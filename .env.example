# Copy this file to .env and fill in real values.
# .env is never committed. Each member keeps their own copy.

# --- Environment ---------------------------------------------------------
# local | ci | production. Controls cookie flags and error verbosity.
ENVIRONMENT=local

# --- PostgreSQL ----------------------------------------------------------
# Used by the postgres service in docker-compose.yml.
POSTGRES_USER=bugtriage
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=bugtriage
# Host port the database is published on. Change it if 5432 is already taken.
POSTGRES_PORT=5432

# Connection string used by the backend.
# Inside Docker Compose the host is the service name "db".
# Running the backend directly on your machine, use localhost.
DATABASE_URL=postgresql+psycopg://bugtriage:change-me-locally@db:5432/bugtriage

# --- Authentication ------------------------------------------------------
# Signing key for the session token. Generate your own, do not reuse this one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=generate-your-own-32-byte-secret
# Signing algorithm for the session token.
JWT_ALGORITHM=HS256
# Session lifetime in minutes. NFR-03 caps this at 60.
SESSION_EXPIRE_MINUTES=60
# Name of the httpOnly cookie carrying the session token.
SESSION_COOKIE_NAME=session
# Send the cookie only over HTTPS. Keep false for local http development.
COOKIE_SECURE=false

# --- Ports ---------------------------------------------------------------
# Host port for the FastAPI service.
BACKEND_PORT=8000
# Host port for the Vite dev server.
FRONTEND_PORT=5173
# Where the Vite dev proxy forwards /api requests.
# Inside Docker Compose this is http://backend:8000.
VITE_PROXY_TARGET=http://backend:8000
